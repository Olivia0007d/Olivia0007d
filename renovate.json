{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions"],
  "baseBranches": ["main"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "pruneBranchAfterAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor", "major"],
      "automerge": true
    }
  ]
}
